{
  "name": "zladovce",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:storefront": "ng serve storefront --port 4200",
    "start:admin": "ng serve admin --port 4201",
    "build": "npm run build:storefront && npm run build:admin",
    "build:storefront": "ng build storefront --configuration production",
    "build:admin": "ng build admin --configuration production",
    "lint": "eslint . --max-warnings 0",
    "test": "ng test",
    "test:ci": "ng test libs --watch=false && ng test storefront --watch=false && ng test admin --watch=false",
    "generate:models": "node tools/generate-models.mjs",
    "format": "prettier --write \"apps/**/*.{ts,html,css,scss,json}\" \"libs/**/*.{ts,html,css,json}\""
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.7",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "aws-amplify": "^6.22.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.12.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
